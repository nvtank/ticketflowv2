{
  "name": "tixflow-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm --filter @tf2/shared build && pnpm --filter @tf2/api build",
    "lint": "eslint apps packages tests --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @tf2/shared build && pnpm --filter @tf2/api typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:api": "pnpm --filter @tf2/api dev",
    "db:generate": "pnpm --filter @tf2/api db:generate",
    "db:seed": "pnpm --filter @tf2/api db:seed",
    "db:migrate": "pnpm --filter @tf2/api db:migrate",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker/compose.yml up -d --wait",
    "infra:test:up": "docker compose -f infrastructure/docker/compose.test.yml up -d --wait"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
